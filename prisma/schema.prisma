generator client {
  provider = "prisma-client"
  output   = "../services/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus { ACTIVE INACTIVE SUSPENDED }
enum OrderSource { POS CALL_CENTER MOBILE WEB QR AGGREGATOR }
enum OrderType { DINE_IN TAKEAWAY DELIVERY }
enum OrderStatus { DRAFT CONFIRMED SENT_TO_KITCHEN PREPARING READY ASSIGNED OUT_FOR_DELIVERY DELIVERED CLOSED CANCELLED VOIDED REFUNDED FAILED }
enum PaymentStatus { PENDING PAID PARTIALLY_REFUNDED REFUNDED VOIDED }
enum PaymentAdjustmentType { REFUND VOID }
enum ShiftStatus { OPEN CLOSED }
enum DeviceStatus { ACTIVE INACTIVE BLOCKED }
enum RoleCode { CASHIER CALL_CENTER_OPERATOR CALL_CENTER_SUPERVISOR KITCHEN DISPATCHER BRANCH_MANAGER CENTRAL_ADMIN OWNER }
enum CashDrawerMovementType { OPENING_FLOAT SALE CASH_CHANGE REFUND PAY_IN PAY_OUT ADJUSTMENT }
enum CashDrawerDirection { IN OUT }
enum KitchenStation { KITCHEN BEVERAGE PACKING }
enum KitchenTicketStatus { SENT_TO_KITCHEN PREPARING READY COMPLETED CANCELLED }

model Tenant {
  id String @id @default(cuid())
  slug String @unique
  name String
  nameAr String?
  active Boolean @default(true)
  currency String @default("EGP")
  branches Branch[]
  categories Category[]
  products Product[]
  customers Customer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}

model Branch {
  id String @id @default(cuid())
  code String @unique
  name String
  nameAr String?
  active Boolean @default(true)
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users User[]
  devices Device[]
  orders Order[]
  shifts Shift[]
  sessions Session[]
  cashDrawers CashDrawer[]
  cashDrawerMovements CashDrawerMovement[]
  riskPolicies RiskPolicy[]
  kitchenTickets KitchenTicket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, active])
}

model User {
  id String @id @default(cuid())
  username String @unique
  displayName String
  passwordHash String
  status UserStatus @default(ACTIVE)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id])
  kitchenStation KitchenStation?
  roleLinks UserRole[]
  orders Order[] @relation("CreatedOrders")
  shifts Shift[]
  auditLogs AuditLog[]
  devices Device[]
  sessions Session[]
  cashDrawerMovements CashDrawerMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role { id String @id @default(cuid()) code RoleCode @unique name String userLinks UserRole[] permissions RolePermission[] }
model Permission { id String @id @default(cuid()) code String @unique name String roles RolePermission[] }
model UserRole { userId String roleId String user User @relation(fields: [userId], references: [id], onDelete: Cascade) role Role @relation(fields: [roleId], references: [id], onDelete: Cascade) @@id([userId, roleId]) }
model RolePermission { roleId String permissionId String role Role @relation(fields: [roleId], references: [id], onDelete: Cascade) permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade) @@id([roleId, permissionId]) }

model Device {
  id String @id @default(cuid())
  deviceCode String @unique
  name String
  status DeviceStatus @default(ACTIVE)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  userId String?
  user User? @relation(fields: [userId], references: [id])
  shifts Shift[]
  sessions Session[]
  cashDrawer CashDrawer?
  cashDrawerMovements CashDrawerMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  deviceId String?
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  revokedAt DateTime?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([deviceId, revokedAt])
}

model Category {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name String
  nameAr String?
  sortOrder Int @default(0)
  active Boolean @default(true)
  products Product[]
  @@index([tenantId, active, sortOrder])
}

model Product {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sku String @unique
  name String
  nameAr String?
  price Decimal @db.Decimal(12, 2)
  active Boolean @default(true)
  kitchenStation KitchenStation @default(KITCHEN)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, active])
  @@index([categoryId, active])
}

model Order {
  id String @id @default(cuid())
  orderNumber String
  source OrderSource
  type OrderType
  status OrderStatus @default(DRAFT)
  version Int @default(1)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  createdById String
  createdBy User @relation("CreatedOrders", fields: [createdById], references: [id])
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  items OrderItem[]
  payments Payment[]
  paymentAdjustments PaymentAdjustment[]
  events OrderEvent[]
  kitchenTickets KitchenTicket[]
  total Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([branchId, orderNumber])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model OrderEvent {
  id String @id @default(cuid())
  eventId String @unique
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type String
  actorUserId String?
  deviceId String?
  payload Json
  occurredAt DateTime
  createdAt DateTime @default(now())
  @@index([orderId, occurredAt])
}
model KitchenTicket {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  station KitchenStation
  status KitchenTicketStatus @default(SENT_TO_KITCHEN)
  version Int @default(1)
  sequence Int @default(1)
  sentAt DateTime @default(now())
  preparingAt DateTime?
  readyAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancellationReason String?
  items KitchenTicketItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([orderId, station, sequence])
  @@index([branchId, status, updatedAt])
  @@index([orderId, status])
}
model KitchenTicketItem {
  id String @id @default(cuid())
  ticketId String
  ticket KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItemId String
  nameSnapshot String
  quantity Int
  note String?
  modifiers Json?
  createdAt DateTime @default(now())
  @@unique([ticketId, orderItemId])
  @@index([orderItemId])
}

model Customer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  phone String @unique
  name String?
  orders Order[]
  addresses CustomerAddress[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
}
model CustomerAddress { id String @id @default(cuid()) customerId String customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade) label String? address String area String? notes String? }

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shiftId String
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  amount Decimal @db.Decimal(12, 2)
  method String
  reference String?
  receivedAmount Decimal? @db.Decimal(12, 2)
  changeAmount Decimal @default(0) @db.Decimal(12, 2)
  status PaymentStatus @default(PENDING)
  idempotencyKey String @unique
  adjustments PaymentAdjustment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PaymentAdjustment {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shiftId String
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  type PaymentAdjustmentType
  amount Decimal @db.Decimal(12, 2)
  reason String
  reference String?
  actorUserId String
  deviceId String?
  idempotencyKey String @unique
  operationId String @unique
  createdAt DateTime @default(now())
  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
  @@index([shiftId, createdAt])
}
model Shift {
  id String @id @default(cuid())
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  deviceId String
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  payments Payment[]
  paymentAdjustments PaymentAdjustment[]
  cashDrawerMovements CashDrawerMovement[]
  status ShiftStatus @default(OPEN)
  openingCash Decimal @db.Decimal(12, 2)
  closingCash Decimal? @db.Decimal(12, 2)
  openedAt DateTime @default(now())
  closedAt DateTime?
  @@index([branchId, status])
  @@index([userId, status])
  @@index([deviceId, status])
}
model CashDrawer {
  id String @id @default(cuid())
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  deviceId String @unique
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  name String
  active Boolean @default(true)
  movements CashDrawerMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, active])
}
model CashDrawerMovement {
  id String @id @default(cuid())
  drawerId String
  drawer CashDrawer @relation(fields: [drawerId], references: [id], onDelete: Restrict)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  deviceId String
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  shiftId String
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  type CashDrawerMovementType
  direction CashDrawerDirection
  amount Decimal @db.Decimal(12, 2)
  reason String
  sourceType String?
  sourceId String?
  idempotencyKey String @unique
  operationId String @unique
  metadata Json?
  occurredAt DateTime
  createdAt DateTime @default(now())
  @@index([drawerId, occurredAt])
  @@index([shiftId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([userId, occurredAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorUserId String?
  actor User? @relation(fields: [actorUserId], references: [id])
  branchId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
model RiskPolicy {
  id String @id @default(cuid())
  action String
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  baseScore Int
  amountThreshold Decimal? @db.Decimal(12, 2)
  varianceThreshold Decimal? @db.Decimal(12, 2)
  requiresReason Boolean @default(false)
  requiresApproval Boolean @default(false)
  approvalPermission String?
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([action, branchId, enabled])
  @@index([effectiveFrom, effectiveTo])
}
model SyncOperation {
  id String @id @default(cuid())
  operationId String @unique
  deviceId String
  branchId String
  operation String
  entityType String
  entityId String
  idempotencyKey String @unique
  clientSequence Int
  occurredAt DateTime
  payload Json
  requestHash String
  status String @default("RECEIVED")
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([deviceId, clientSequence])
  @@index([status, createdAt])
}
