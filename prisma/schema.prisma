generator client {
  provider = "prisma-client"
  output   = "../services/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum OrderSource {
  POS
  CALL_CENTER
  MOBILE
  WEB
  QR
  AGGREGATOR
}
enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}
enum OrderStatus {
  DRAFT
  CONFIRMED
  SENT_TO_KITCHEN
  PREPARING
  READY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CLOSED
  CANCELLED
  VOIDED
  REFUNDED
  FAILED
}
enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}
enum PaymentAdjustmentType {
  REFUND
  VOID
}
enum ShiftStatus {
  OPEN
  CLOSED
}
enum DeviceStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}
enum RoleCode {
  CASHIER
  CALL_CENTER_OPERATOR
  CALL_CENTER_SUPERVISOR
  KITCHEN
  DISPATCHER
  BRANCH_MANAGER
  CENTRAL_ADMIN
  OWNER
  HR_MANAGER
  ACCOUNTANT
  INVENTORY_MANAGER
}
enum CashDrawerMovementType {
  OPENING_FLOAT
  SALE
  CASH_CHANGE
  REFUND
  PAY_IN
  PAY_OUT
  ADJUSTMENT
}
enum CashDrawerDirection {
  IN
  OUT
}
enum KitchenStation {
  KITCHEN
  BEVERAGE
  PACKING
}
enum KitchenTicketStatus {
  SENT_TO_KITCHEN
  PREPARING
  READY
  COMPLETED
  CANCELLED
}


enum AttendanceStatus { PRESENT LATE ABSENT LEAVE OFF_DAY }
enum PayrollStatus { DRAFT APPROVED PAID CANCELLED }
enum InventoryUnit { GRAM KILOGRAM BAG MILLILITER LITER PIECE BOX PACK }
enum InventoryMovementType { PURCHASE CONSUMPTION WASTE ADJUSTMENT_IN ADJUSTMENT_OUT TRANSFER_IN TRANSFER_OUT }
enum AccountingAccountType { ASSET LIABILITY EQUITY REVENUE EXPENSE }
enum WorkspaceCode { POS CALL_CENTER KITCHEN DISPATCH HR ACCOUNTING INVENTORY MANAGEMENT }
enum WarehouseType { CENTRAL BRANCH }

model Tenant {
  id String @id @default(cuid())
  slug String @unique
  name String
  nameAr String?
  active Boolean @default(true)
  currency String @default("EGP")
  branches Branch[]
  users User[]
  sessions Session[]
  warehouses Warehouse[]
  departments Department[]
  warehouseStockBalances WarehouseStockBalance[]
  inventoryTransfers InventoryTransfer[]
  branchProducts BranchProduct[]
  categories Category[]
  products Product[]
  customers Customer[]
  employeeProfiles EmployeeProfile[]
  workSchedules WorkSchedule[]
  attendanceRecords AttendanceRecord[]
  payrollPeriods PayrollPeriod[]
  payrollEntries PayrollEntry[]
  suppliers Supplier[]
  ingredients Ingredient[]
  inventoryStockBalances InventoryStockBalance[]
  inventoryReceipts InventoryReceipt[]
  inventoryMovements InventoryMovement[]
  recipeIngredients RecipeIngredient[]
  accountingAccounts AccountingAccount[]
  journalEntries JournalEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}

model Branch {
  id String @id @default(cuid())
  code String
  name String
  nameAr String?
  active Boolean @default(true)
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users User[]
  devices Device[]
  orders Order[]
  shifts Shift[]
  sessions Session[]
  cashDrawers CashDrawer[]
  cashDrawerMovements CashDrawerMovement[]
  riskPolicies RiskPolicy[]
  kitchenTickets KitchenTicket[]
  branchProducts BranchProduct[]
  workSchedules WorkSchedule[]
  attendanceRecords AttendanceRecord[]
  inventoryStockBalances InventoryStockBalance[]
  inventoryReceipts InventoryReceipt[]
  inventoryMovements InventoryMovement[]
  journalEntries JournalEntry[]
  journalLines JournalLine[]
  warehouses Warehouse[]
  departments Department[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model AccountingAccount {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code String
  name String
  nameAr String?
  type AccountingAccountType
  active Boolean @default(true)
  journalLines JournalLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId, type, active])
}

model JournalEntry {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entryNumber String
  description String
  sourceType String
  sourceId String
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  postedAt DateTime @default(now())
  lines JournalLine[]
  createdAt DateTime @default(now())
  @@unique([tenantId, entryNumber])
  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, branchId, postedAt])
}

model JournalLine {
  id String @id @default(cuid())
  entryId String
  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  debit Decimal @db.Decimal(14, 2) @default(0)
  credit Decimal @db.Decimal(14, 2) @default(0)
  memo String?
  @@index([entryId])
  @@index([accountId, branchId])
}

model User {
  id String @id @default(cuid())
  username String @unique
  displayName String
  passwordHash String
  status UserStatus @default(ACTIVE)
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id])
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  kitchenStation KitchenStation?
  roleLinks UserRole[]
  orders Order[] @relation("CreatedOrders")
  shifts Shift[]
  auditLogs AuditLog[]
  devices Device[]
  requestedInventoryTransfers InventoryTransfer[] @relation("TransferRequestedBy")
  approvedInventoryTransfers InventoryTransfer[] @relation("TransferApprovedBy")
  sessions Session[]
  cashDrawerMovements CashDrawerMovement[]
  employeeProfile EmployeeProfile?
  attendanceRecords AttendanceRecord[]
  workSchedules WorkSchedule[]
  payrollEntries PayrollEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
}

model Role {
  id String @id @default(cuid())
  code RoleCode @unique
  name String
  userLinks UserRole[]
  permissions RolePermission[]
}
model Permission {
  id String @id @default(cuid())
  code String @unique
  name String
  roles RolePermission[]
}
model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}
model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model EmployeeProfile { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) userId String @unique user User @relation(fields: [userId], references: [id], onDelete: Cascade) employeeCode String jobTitle String phone String? nationalIdLast4 String? hireDate DateTime? terminationDate DateTime? baseSalary Decimal @db.Decimal(12, 2) overtimeRate Decimal @db.Decimal(12, 2) @default(0) active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([tenantId, employeeCode]) @@index([tenantId, active]) }
model WorkSchedule { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) userId String user User @relation(fields: [userId], references: [id], onDelete: Cascade) branchId String? branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict) weekday Int startMinute Int endMinute Int breakMinutes Int @default(0) effectiveFrom DateTime effectiveTo DateTime? active Boolean @default(true) @@index([tenantId, userId, weekday, active]) @@index([branchId, weekday, active]) }
model AttendanceRecord { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) userId String user User @relation(fields: [userId], references: [id], onDelete: Cascade) branchId String branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict) workDate DateTime status AttendanceStatus @default(PRESENT) scheduledStartMinute Int? scheduledEndMinute Int? checkInAt DateTime? checkOutAt DateTime? workedMinutes Int @default(0) overtimeMinutes Int @default(0) lateMinutes Int @default(0) notes String? approvedById String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([userId, workDate]) @@index([tenantId, workDate, status]) @@index([branchId, workDate]) }
model PayrollPeriod { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) name String periodStart DateTime periodEnd DateTime status PayrollStatus @default(DRAFT) entries PayrollEntry[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([tenantId, periodStart, periodEnd]) @@index([tenantId, status, periodStart]) }
model PayrollEntry { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) periodId String period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade) userId String user User @relation(fields: [userId], references: [id], onDelete: Restrict) baseSalary Decimal @db.Decimal(12, 2) overtimeAmount Decimal @db.Decimal(12, 2) @default(0) bonuses Decimal @db.Decimal(12, 2) @default(0) deductions Decimal @db.Decimal(12, 2) @default(0) netAmount Decimal @db.Decimal(12, 2) paidAt DateTime? notes String? @@unique([periodId, userId]) @@index([tenantId, userId]) }
model Supplier { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) name String phone String? active Boolean @default(true) receipts InventoryReceipt[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([tenantId, name]) @@index([tenantId, active]) }
model Ingredient { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) sku String name String nameAr String? baseUnit InventoryUnit purchaseUnit InventoryUnit purchaseUnitFactor Decimal @db.Decimal(14, 4) reorderLevel Decimal @db.Decimal(14, 4) @default(0) active Boolean @default(true) stockBalances InventoryStockBalance[] warehouseStockBalances WarehouseStockBalance[] movements InventoryMovement[] purchaseItems InventoryReceiptItem[] recipeItems RecipeIngredient[] transferItems InventoryTransferItem[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([tenantId, sku]) @@index([tenantId, active]) }
model InventoryStockBalance { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) branchId String branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict) ingredientId String ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict) quantityBaseUnit Decimal @db.Decimal(14, 4) @default(0) averageCostPerBaseUnit Decimal @db.Decimal(14, 6) @default(0) updatedAt DateTime @updatedAt @@unique([branchId, ingredientId]) @@index([tenantId, branchId]) }
model InventoryReceipt { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) branchId String branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict) supplierId String? supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict) reference String? receivedAt DateTime @default(now()) totalCost Decimal @db.Decimal(12, 2) items InventoryReceiptItem[] createdAt DateTime @default(now()) @@index([tenantId, branchId, receivedAt]) }
model InventoryReceiptItem { id String @id @default(cuid()) receiptId String receipt InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade) ingredientId String ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict) quantityPurchaseUnit Decimal @db.Decimal(14, 4) quantityBaseUnit Decimal @db.Decimal(14, 4) unitCost Decimal @db.Decimal(12, 4) totalCost Decimal @db.Decimal(12, 2) @@index([ingredientId]) }
model InventoryMovement { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) branchId String? branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict) warehouseId String? warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict) ingredientId String ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict) type InventoryMovementType quantityBaseUnit Decimal @db.Decimal(14, 4) unitCost Decimal @db.Decimal(12, 6) @default(0) referenceType String? referenceId String? idempotencyKey String @unique actorUserId String? createdAt DateTime @default(now()) @@index([tenantId, branchId, ingredientId, createdAt])
  @@index([tenantId, warehouseId, ingredientId, createdAt]) @@index([ingredientId, createdAt]) }
model RecipeIngredient { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict) productId String product Product @relation(fields: [productId], references: [id], onDelete: Cascade) ingredientId String ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict) quantityBaseUnit Decimal @db.Decimal(14, 4) wastePercent Decimal @db.Decimal(5, 2) @default(0) @@unique([productId, ingredientId]) @@index([tenantId, productId]) }

model Warehouse {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code String
  name String
  nameAr String?
  type WarehouseType
  active Boolean @default(true)
  stockBalances WarehouseStockBalance[]
  inventoryMovements InventoryMovement[]
  outgoingTransfers InventoryTransfer[] @relation("TransferSource")
  incomingTransfers InventoryTransfer[] @relation("TransferTarget")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId, type, active])
}

model WarehouseStockBalance {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantityBaseUnit Decimal @db.Decimal(14, 4) @default(0)
  averageCostPerBaseUnit Decimal @db.Decimal(14, 6) @default(0)
  updatedAt DateTime @updatedAt
  @@unique([warehouseId, ingredientId])
  @@index([tenantId, warehouseId])
}

model InventoryTransfer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transferNumber String
  fromWarehouseId String
  fromWarehouse Warehouse @relation("TransferSource", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId String
  toWarehouse Warehouse @relation("TransferTarget", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  status String @default("DRAFT")
  requestedById String?
  requestedBy User? @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy User? @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  requestedAt DateTime?
  approvedAt DateTime?
  sentAt DateTime?
  receivedAt DateTime?
  notes String?
  items InventoryTransferItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, transferNumber])
  @@index([tenantId, status, createdAt])
}

model InventoryTransferItem {
  id String @id @default(cuid())
  transferId String
  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantityBaseUnit Decimal @db.Decimal(14, 4)
  unitCost Decimal @db.Decimal(12, 6) @default(0)
  createdAt DateTime @default(now())
  @@index([transferId])
  @@index([ingredientId])
}

model Department {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code String
  name String
  nameAr String?
  central Boolean @default(false)
  active Boolean @default(true)
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId, branchId, active])
}

model Device {
  id String @id @default(cuid())
  deviceCode String @unique
  name String
  status DeviceStatus @default(ACTIVE)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  userId String?
  user User? @relation(fields: [userId], references: [id])
  shifts Shift[]
  sessions Session[]
  cashDrawer CashDrawer?
  cashDrawerMovements CashDrawerMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  deviceId String?
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  revokedAt DateTime?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([userId, revokedAt])
  @@index([tenantId, revokedAt])
  @@index([expiresAt])
  @@index([deviceId, revokedAt])
}

model Category {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name String
  nameAr String?
  sortOrder Int @default(0)
  active Boolean @default(true)
  products Product[]
  @@index([tenantId, active, sortOrder])
}
model Product {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sku String
  name String
  nameAr String?
  price Decimal @db.Decimal(12, 2)
  active Boolean @default(true)
  kitchenStation KitchenStation @default(KITCHEN)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  recipeIngredients RecipeIngredient[]
  branchProducts BranchProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, sku])
  @@index([tenantId, active])
  @@index([categoryId, active])
}

model BranchProduct {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceOverride Decimal? @db.Decimal(12, 2)
  enabled Boolean @default(true)
  available Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([branchId, productId])
  @@index([tenantId, branchId, enabled, available])
  @@index([productId, branchId])
}

model Order {
  id String @id @default(cuid())
  orderNumber String
  source OrderSource
  type OrderType
  status OrderStatus @default(DRAFT)
  version Int @default(1)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  createdById String
  createdBy User @relation("CreatedOrders", fields: [createdById], references: [id])
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  items OrderItem[]
  payments Payment[]
  paymentAdjustments PaymentAdjustment[]
  events OrderEvent[]
  kitchenTickets KitchenTicket[]
  total Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([branchId, orderNumber])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model OrderEvent {
  id String @id @default(cuid())
  eventId String @unique
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type String
  actorUserId String?
  deviceId String?
  payload Json
  occurredAt DateTime
  createdAt DateTime @default(now())
  @@index([orderId, occurredAt])
}
model KitchenTicket {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  station KitchenStation
  status KitchenTicketStatus @default(SENT_TO_KITCHEN)
  version Int @default(1)
  sequence Int @default(1)
  sentAt DateTime @default(now())
  preparingAt DateTime?
  readyAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancellationReason String?
  items KitchenTicketItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([orderId, station, sequence])
  @@index([branchId, status, updatedAt])
  @@index([orderId, status])
}
model KitchenTicketItem {
  id String @id @default(cuid())
  ticketId String
  ticket KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItemId String
  nameSnapshot String
  quantity Int
  note String?
  modifiers Json?
  createdAt DateTime @default(now())
  @@unique([ticketId, orderItemId])
  @@index([orderItemId])
}

model Customer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  phone String
  name String?
  orders Order[]
  addresses CustomerAddress[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, phone])
  @@index([tenantId])
}
model CustomerAddress {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label String?
  address String
  area String?
  notes String?
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shiftId String
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  amount Decimal @db.Decimal(12, 2)
  method String
  reference String?
  receivedAmount Decimal? @db.Decimal(12, 2)
  changeAmount Decimal @default(0) @db.Decimal(12, 2)
  status PaymentStatus @default(PENDING)
  idempotencyKey String @unique
  adjustments PaymentAdjustment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PaymentAdjustment {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shiftId String
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  type PaymentAdjustmentType
  amount Decimal @db.Decimal(12, 2)
  reason String
  reference String?
  actorUserId String
  deviceId String?
  idempotencyKey String @unique
  operationId String @unique
  createdAt DateTime @default(now())
  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
  @@index([shiftId, createdAt])
}
model Shift {
  id String @id @default(cuid())
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  deviceId String
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  payments Payment[]
  paymentAdjustments PaymentAdjustment[]
  cashDrawerMovements CashDrawerMovement[]
  status ShiftStatus @default(OPEN)
