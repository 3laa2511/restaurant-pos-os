DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_pos"
PORT=3000

# PostgreSQL connection pool (per API process/replica)
# Size this against the database connection budget; do not create a new DB connection per request.
DB_POOL_MAX=10
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000

# Local Vite and Tauri desktop origins; override per environment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost,http://localhost:1420
