{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restaurant POS",
  "version": "0.1.0",
  "identifier": "com.restaurantpos.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Restaurant POS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
